{
  "expo": {
    "name": "شعلة الجنوب",
    "slug": "sholat-aljanoub",
    "scheme": "sholataljanoub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ps.sholataljanoub.app",
      "supportsTablet": false,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "ps.sholataljanoub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1c1917"
      }
    },
    "locales": {
      "ar": "./src/lib/locales/ar.json",
      "en": "./src/lib/locales/en.json"
    },
    "extra": {
      "supportsRTL": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "التطبيق يحتاج الكاميرا لتصوير إثبات التسليم / The app uses the camera for delivery photos."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
