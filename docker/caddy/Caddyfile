# HTTPS-Zertifikat holt Caddy automatisch (Domain muss per DNS auf den Server zeigen)
{$DOMAIN} {
	encode zstd gzip
	# Uploads (Lizenz, Bilder, Import) bis 25 MB
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy web:3000
}

# www → ohne www
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
