# ─────────────────────────────────────────────────────────────────────────────
# Sholat Aljanoub – Umgebungsvariablen
# Kopieren:  cp .env.example .env    (Werte für Produktion unbedingt ändern!)
# ─────────────────────────────────────────────────────────────────────────────

# --- Allgemein ---------------------------------------------------------------
NODE_ENV=production
# Öffentliche Basis-URL (für Links in SMS, QR-Codes auf PDFs)
APP_URL=http://localhost:3000
WEB_PORT=3000
TZ=Asia/Hebron

# --- Datenbank (PostgreSQL) --------------------------------------------------
POSTGRES_USER=sa
POSTGRES_PASSWORD=sa_dev_password
POSTGRES_DB=sholat_aljanoub
POSTGRES_PORT=5432
# Für lokale Entwicklung außerhalb von Docker (im Container wird sie überschrieben)
DATABASE_URL=postgresql://sa:sa_dev_password@localhost:5432/sholat_aljanoub?schema=public
# Eigene Datenbank für Integrationstests (wird automatisch angelegt und migriert)
TEST_DATABASE_URL=postgresql://sa:sa_dev_password@localhost:5432/sa_test?schema=public

# --- Sessions & Sicherheit ---------------------------------------------------
# Mindestens 32 zufällige Zeichen:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Lebensdauer in Tagen (Kunden / Mitarbeiter)
SESSION_TTL_DAYS_CUSTOMER=60
SESSION_TTL_DAYS_STAFF=1
# Cookies nur über HTTPS (in Produktion hinter TLS auf true setzen)
COOKIE_SECURE=false

# --- OTP / SMS ---------------------------------------------------------------
# Adapter: "log" (schreibt Code in Konsole + NotificationLog) | später z. B. "jawwal", "bulksms"
SMS_PROVIDER=log
SMS_SENDER_NAME=SholatAljanoub
SMS_API_URL=
SMS_API_KEY=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Rate-Limits: max. Codes pro Telefon / Fenster, max. Anfragen pro IP / Fenster
OTP_LIMIT_PER_PHONE=3
OTP_LIMIT_PHONE_WINDOW_SECONDS=600
OTP_LIMIT_PER_IP=20
OTP_LIMIT_IP_WINDOW_SECONDS=3600
# NUR für Entwicklung/Tests: fester Code für alle Nummern (leer lassen in Produktion!)
OTP_DEV_FIXED_CODE=

# --- WhatsApp (Adapter, bis Phase 6 nur Log) ----------------------------------
WHATSAPP_PROVIDER=log

# --- Dateien (MinIO / S3) ----------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sa-files
S3_ACCESS_KEY=sa_minio
S3_SECRET_KEY=sa_minio_secret
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Max. Uploadgröße (Gewerbelizenz, Bilder) in MB
UPLOAD_MAX_MB=10

# --- E-Mail (Mailpit in Entwicklung) -----------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Sholat Aljanoub <no-reply@sholat-aljanoub.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Zahlungs-Gateway (Phase 6) ----------------------------------------------
# "fake" (nur Entwicklung, Testseite) | "paytabs" | "arabbank" (Mastercard Gateway / MPGS)
PAYMENT_GATEWAY=fake
# Basis-URL des Anbieters (Standard: https://secure.paytabs.com bzw. https://ap-gateway.mastercard.com)
PAYMENT_GATEWAY_URL=
# PayTabs: Profile-ID · Arab Bank: Merchant-ID
PAYMENT_GATEWAY_MERCHANT_ID=
# PayTabs: Server Key · Arab Bank: API-Passwort
PAYMENT_GATEWAY_API_KEY=
# nur fake: Schlüssel für die signierten Test-Callbacks (sonst SESSION_SECRET)
PAYMENT_GATEWAY_CALLBACK_SECRET=
# unbezahlte Kartenbestellungen nach X Minuten stornieren
PAYMENT_TIMEOUT_MINUTES=60

# --- Seed / Erst-Admin -------------------------------------------------------
# Wird beim ersten Start als Inhaber angelegt (danach im Admin änderbar)
SEED_OWNER_PHONE=+970599000001
SEED_OWNER_NAME=المالك
SEED_OWNER_PASSWORD=ChangeMe!2026
# Demo-Daten (Beispielbenutzer pro Rolle usw.) anlegen: true/false
SEED_DEMO_DATA=true
# Passwort aller Demo-Mitarbeiter (+970599000002 … 006)
SEED_DEMO_PASSWORD=Demo-2026-pass
# Seed beim Container-Start automatisch ausführen (idempotent)
SEED_ON_START=true

# --- Backups -----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
PRISMA_LOG=0
